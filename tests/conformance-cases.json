      "expected_valid": false,
      "required_error": "actual_card_change cannot be true before incorporation and revision event creation."
    },
    {
      "id": "incorporated-change-requires-revision",
      "category": "revision_event_integrity",
      "description": "An incorporated public-record change must link to a RevisionEvent.",
      "input": {
        "state": "incorporated",
        "actual_card_change": true,
        "revision_event_id": null
      },
      "expected_valid": false,
      "required_error": "actual_card_change true requires revision_event_id."
    },
    {
      "id": "revision-event-reconstructs-before-after",
