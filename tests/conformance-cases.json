      "input": {
        "model_provider": "OpenAI",
        "model_name": "configured OpenAI reasoning model",
        "reader_role": "structurer",
        "input_scope": "Prior synthesis and proposed revision.",
        "used_external_sources": false,
        "source_list": [],
        "output_summary": "The revision narrows overclaiming.",
        "proposed_lane": "correction",
