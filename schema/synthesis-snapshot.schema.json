{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civiclogos.com/schema/synthesis-snapshot.schema.json",
  "title": "SynthesisSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_id",
    "topic_id",
    "synthesis_text",
    "version_label",
    "created_at",
    "content_hash",
    "unresolved_items"
  ],
  "properties": {
    "snapshot_id": { "type": "string", "minLength": 1 },
    "topic_id": { "type": "string", "minLength": 1 },
    "claim_id": { "type": ["string", "null"] },
    "synthesis_text": { "type": "string", "minLength": 1 },
    "version_label": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "created_by_actor_id": { "type": ["string", "null"] },
    "source_revision_event_id": { "type": ["string", "null"] },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[a-fA-F0-9]{64}$"
    },
    "unresolved_items": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
