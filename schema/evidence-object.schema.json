{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civiclogos.com/schema/evidence-object.schema.json",
  "title": "EvidenceObject",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "title",
    "source_type",
    "summary",
    "public_access",
    "submitted_at"
  ],
  "properties": {
    "evidence_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "source_type": {
      "type": "string",
      "enum": ["url", "document", "dataset", "citation", "testimony", "derived_summary", "other"]
    },
    "url": { "type": ["string", "null"], "format": "uri" },
    "document_id": { "type": ["string", "null"] },
    "citation": { "type": ["string", "null"] },
    "summary": { "type": "string", "minLength": 1 },
    "submitted_by_actor_id": { "type": ["string", "null"] },
    "public_access": {
      "type": "string",
      "enum": ["public", "restricted", "private_metadata_redacted"]
    },
    "submitted_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "source_type": { "const": "url" } }, "required": ["source_type"] },
      "then": {
        "required": ["url"],
        "properties": {
          "url": { "type": "string", "format": "uri" }
        }
      }
    },
    {
      "if": { "properties": { "source_type": { "const": "document" } }, "required": ["source_type"] },
      "then": {
        "required": ["document_id"],
        "properties": {
          "document_id": { "type": "string", "minLength": 1 }
        }
      }
    }
  ]
}
