{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civiclogos.com/schema/revision-event.schema.json",
  "title": "RevisionEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revision_id",
    "topic_id",
    "triggering_record_id",
    "previous_synthesis_snapshot_id",
    "new_synthesis_snapshot_id",
    "changed_fields",
    "reason_for_change",
    "reviewer_note",
    "review_decision_id",
    "origin",
    "created_at",
    "content_hash",
    "unresolved_after_revision"
  ],
  "properties": {
    "revision_id": { "type": "string", "minLength": 1 },
    "topic_id": { "type": "string", "minLength": 1 },
    "triggering_record_id": { "type": "string", "minLength": 1 },
    "previous_synthesis_snapshot_id": { "type": "string", "minLength": 1 },
    "new_synthesis_snapshot_id": { "type": "string", "minLength": 1 },
    "changed_fields": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "reason_for_change": { "type": "string", "minLength": 1 },
    "reviewer_note": { "type": "string", "minLength": 1 },
    "review_decision_id": { "type": "string", "minLength": 1 },
    "origin": {
      "type": "string",
      "enum": [
        "outside_public_submission",
        "maintainer_promoted_candidate",
        "founder_submitted",
        "founder_maintainer",
        "ai_origin",
        "prototype_fixture",
        "institutional_pilot"
      ]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[a-fA-F0-9]{64}$"
    },
    "unresolved_after_revision": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
