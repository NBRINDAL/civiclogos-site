SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=hello@civiclogos.com
SMTP_PASS=replace-with-your-mailbox-password
CONTACT_TO=hello@civiclogos.com
CONTACT_FROM=hello@civiclogos.com
MAINTAINER_NOTIFICATION_TO=hello@civiclogos.com
# Use one maintainer auth key. MAINTAINER_REVIEW_KEY remains as a legacy alias.
CIVIC_LOGOS_MAINTAINER_KEY=
MAINTAINER_REVIEW_KEY=
# Comma-separated first-party write origins when preview and production hosts both need write access.
CIVIC_LOGOS_ALLOWED_ORIGINS=
# Set per environment: preview URL on preview deployments, civiclogos.com on production.
NEXT_PUBLIC_SITE_URL=https://civiclogos.com
# Any one of the database URLs below is enough to enable durable storage.
DATABASE_URL=
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
# AI keys are optional for read-only/public audit surfaces, but required for AI-assisted ask intake.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
